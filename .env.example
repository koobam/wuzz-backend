# Local development only. See internal/pkg/config/config.go for defaults —
# every variable here has one, so `make dev && make run SERVICE=gateway`
# works with none of this set.

APP_ENV=dev
LOG_LEVEL=debug
LOG_FORMAT=text

# No JWT keys here on purpose. In dev every service falls back to the same
# fixed Ed25519 keypair baked into authn/keys.go, so a token minted by `user`
# verifies in `gateway` with nothing configured. Staging and production
# refuse to start without real keys (base64-encoded raw Ed25519 key bytes):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEYS=

# Port 5433, not 5432 — see the comment on docker-compose.yml's postgres
# service for why.
# Left unset on purpose: each service picks its own database (wuzz, wuzz_catalog,
# wuzz_transaction, wuzz_gateway for the gateway's activity log). One DSN here would point every service at the same one.
# POSTGRES_DSN=postgres://wuzz:wuzz@localhost:5433/wuzz?sslmode=disable
# Port 6380, not 6379 — see the comment on docker-compose.yml's redis service.
REDIS_ADDR=localhost:6380

# Twilio Verify — leave unset (or TWILIO_DEV_MODE=true) to use the logging
# verifier instead, which prints the code to the log rather than sending SMS.
TWILIO_DEV_MODE=true
# A fixed code for every sign-in, so dev and staging need no log. Needs TWILIO_DEV_MODE=true; the user
# service refuses to start with it in production.
OTP_FIXED_CODE=000000

# The secret the order service shows the catalog to take an order's materials out of stock. Dev has a built-in key; set the same
# value (16+ characters) on the catalog and transaction services everywhere else.
# INTERNAL_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SID=

# gateway only
CORS_ORIGINS=http://localhost:5174
COOKIE_SECURE=false
USER_ADDR=localhost:9090

# Typesense — the search index behind the list endpoints (orders, outlets, services, materials, variant and modifier groups).
# Set on the catalog and transaction services. With no URL they list straight from Postgres; with one, a search that cannot
# reach Typesense is a 503, never a quiet switch back to Postgres. Port 8109, not 8108: see docker-compose.yml.
TYPESENSE_URL=http://localhost:8109
TYPESENSE_API_KEY=wuzz-dev-typesense-key

# Media — where uploaded pictures (outlet photos) are kept. Only the gateway uses it (POST /backoffice/v1/uploads).
# Staging / production: an S3-compatible bucket. Cloudflare R2 and Google Cloud Storage (its S3 interoperability API, HMAC keys,
# endpoint https://storage.googleapis.com, region auto) both work; PUBLIC_BASE_URL is the address browsers read from (the assets
# worker in wuzz-deployments/cloudflare serves assets-stg.wuzz.care / assets.wuzz.care from the GCS media buckets).
# With none of these set, uploads answer 503 "Uploads are not configured"; a half-set bucket stops the gateway at start.
# MEDIA_ENDPOINT=https://storage.googleapis.com
# MEDIA_BUCKET=testing-media-staging
# MEDIA_ACCESS_KEY_ID=
# MEDIA_SECRET_ACCESS_KEY=
# MEDIA_REGION=auto
# MEDIA_PUBLIC_BASE_URL=https://assets-stg.wuzz.care
# MEDIA_MAX_UPLOAD_BYTES=5242880
# Dev only (refused in staging and production): keep the pictures on this machine's disk; the gateway serves them under /media.
MEDIA_LOCAL_DIR=.data/media
MEDIA_PUBLIC_BASE_URL=http://localhost:8092/media
