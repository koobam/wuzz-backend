# Wuzz production. Copy to .env.production and fill in the blanks (or let a script generate
# it: wuzz-deployments/vm/scripts/gen-env.sh production). The real file is never committed.
#
# The VM compose file (wuzz-deployments/vm/docker-compose.yml) reads this file with
# `--env-file`, and fans the values out to each service: the per-service Postgres
# DSNs, Redis, Kafka/Redpanda and the gRPC addresses are set there, not here.

APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

# Where the images come from, and which build to run (a short commit).
REGISTRY=ghcr.io/koobam/wuzz
TAG=latest

# Public hosts. The API is api.wuzz.care; CORS_ORIGINS are the web apps allowed to call it
# (comma-separated, no trailing slash).
CORS_ORIGINS=https://wuzz.care

# Secrets: generate fresh ones per environment, never reuse across staging and production.
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
# base64 Ed25519 keys: `go run ./cmd/genkey`
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=

# MongoDB (chat history, wuzz-support). Leave empty to use the compose container.
SUPPORT_MONGODB_URI=

# Cloudflare Tunnel token, from the tunnel's public hostname setup.
TUNNEL_TOKEN=

# Phone verification. Production must send real SMS: fill in all three Twilio values.
TWILIO_DEV_MODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# Search (optional): leave empty and catalog matches services in memory.
# TYPESENSE_URL=http://typesense:8108
# TYPESENSE_API_KEY=

# Error reporting (Sentry). Empty keeps it off; with a DSN every ERROR log becomes an issue.
SENTRY_DSN=
